# EcoScan IN Environment Configuration
# Copy this file to .env and set your keys below.
# DO NOT commit your actual API keys to version control.

# Google Gemini API Key (Required for EcoAi chatbot and Vision scanner)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Optional, defaults to 3000)
PORT=3000

# Authorized Digital Reward Provider Configuration (Required for digital reward fulfillment)
# Supported types: xoxoday, gyft, pinelabs, partner_api, none
REWARD_PROVIDER_TYPE=none
REWARD_PROVIDER_API_KEY=your_reward_provider_api_key_here
REWARD_PROVIDER_CLIENT_ID=your_reward_provider_client_id_here
REWARD_PROVIDER_BASE_URL=https://api.rewardprovider.com

# Optional Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
